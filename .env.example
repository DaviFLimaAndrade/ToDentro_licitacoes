# Copie para .env e preencha. Nunca faça commit do .env.

# Groq (buscador e judge) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (leitor) — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 = sem "thinking" (extração não precisa; geração 3x mais rápida). -1 = padrão dinâmico do modelo
GEMINI_THINKING_BUDGET=0

# Phoenix local (opcional)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Limite por pessoa (IP) por dia nas ações com IA
LIMITE_RESUMOS_DIA=10
LIMITE_BUSCAS_DIA=15
